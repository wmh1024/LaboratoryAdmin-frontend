# 后端接口地址（留空时使用默认值 /api，配合 Vite proxy 或同域部署）
VITE_API_BASE_URL=/api

# 开发服务器监听地址（默认仅本机；容器/远程开发可设为 0.0.0.0）
# VITE_DEV_HOST=0.0.0.0

# 是否启用内置 Mock 服务（无后端时设为 true 即可完整运行项目）
# 注意：该开关仅对 `npm run dev` 生效；`npm run build` 会强制排除 Mock，
#       需要纯静态演示产物请使用 `npm run build:demo`
VITE_USE_MOCK=true

# Mock 演示账号（仅演示模式使用）：demo_admin / demo1234
