{
    "name": "labadmin-frontend",
    "version": "0.1.0",
    "private": true,
    "packageManager": "npm@11.6.2",
    "description": "实验室预约系统 · 管理端（Vue3 + Element Plus），内置可离线运行的 Mock 数据",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/wmh1024/LaboratoryAdmin-frontend.git"
    },
    "homepage": "https://github.com/wmh1024/LaboratoryAdmin-frontend#readme",
    "bugs": {
        "url": "https://github.com/wmh1024/LaboratoryAdmin-frontend/issues"
    },
    "keywords": [
        "vue3",
        "element-plus",
        "vite",
        "laboratory",
        "admin",
        "mock"
    ],
    "engines": {
        "node": "^20.19.0 || >=22.12.0",
        "npm": ">=9.0.0"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:prod": "vite build --mode production",
        "build:demo": "vite build --mode demo",
        "preview": "vite preview",
        "preview:demo": "vite preview --mode demo --port 4173 --strictPort",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "smoke": "npm run build:demo && node scripts/smoke.mjs",
        "smoke:shots": "npm run build:demo && node scripts/smoke.mjs --screenshots",
        "check:bundle": "node scripts/check-bundle.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{js,vue,css,scss}\" \"build/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"*.{js,mjs}\" \"package.json\"",
        "format:check": "prettier --check \"src/**/*.{js,vue,css,scss}\" \"build/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"*.{js,mjs}\" \"package.json\"",
        "audit": "npm audit --omit=dev"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.1.0",
        "axios": "^1.5.1",
        "element-plus": "^2.4.1",
        "pinia": "^2.1.7",
        "pinia-plugin-persistedstate": "^3.2.0",
        "vue": "^3.5.0",
        "vue-router": "^4.2.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^4.1.12",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^15.15.0",
        "jsdom": "^25.0.1",
        "playwright-core": "^1.64.1",
        "prettier": "^3.9.10",
        "sass": "^1.106.1",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.3.5",
        "vitest": "^4.1.12"
    }
}
