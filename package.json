{
  "name": "labadmin-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "description": "实验室预约系统 · 管理端（Vue3 + Element Plus），内置可离线运行的 Mock 数据",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmh1024/LaboratoryAdmin-frontend.git"
  },
  "homepage": "https://github.com/wmh1024/LaboratoryAdmin-frontend#readme",
  "bugs": {
    "url": "https://github.com/wmh1024/LaboratoryAdmin-frontend/issues"
  },
  "keywords": [
    "vue3",
    "element-plus",
    "vite",
    "laboratory",
    "admin",
    "mock"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=9.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css,scss}\" \"build/**/*.js\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css,scss}\" \"build/**/*.js\" \"*.js\"",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.1.0",
    "axios": "^1.5.1",
    "element-plus": "^2.4.1",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.0",
    "vue": "^3.3.4",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
